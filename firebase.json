  "hosting": [
    {
      "site": "luchtzorg",
      "public": "frontend",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "redirects": [
        {
          "source": "/LuchtZorg_Challenge3_Submission.zip",
          "destination": "https://storage.googleapis.com/luchtzorg-submission/LuchtZorg_Challenge3_Submission.zip",
